# Cloudflare (wrangler.jsonc → assets.directory: "./") публикует корень
# репозитория. Здесь исключено всё, что не нужно браузеру: сайту нужны
# только index.html, data/, locales/, assets/. Синтаксис как у .gitignore.
# Добавили в корень новый служебный файл или папку — допишите сюда.

# VCS, CI, окружение агентов
.superpowers
.git
.github
.gitignore
.claude
.impeccable
.playwright
.playwright-cli
.playwright-mcp
.wrangler
.dev.vars
.assetsignore
skills-lock.json
wrangler.jsonc

# Инструменты, тесты, документация
tools
tests
upstream
docs
node_modules
package.json
package-lock.json
playwright.config.mjs
test-results
playwright-report
*.md
*.py
*.bak
